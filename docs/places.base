filters:
  and:
    - file.hasTag("place")
properties:
  title:
    displayName: Name
  note.category:
    displayName: Category
  note.coordinates:
    displayName: Coordinates
views:
  - type: map
    name: World Map
    coordinates: note.coordinates
    defaultZoom: 2
    order:
      - title
      - note.category
  - type: table
    name: All Places
    order:
      - file.name
      - title
      - note.category
      - note.coordinates
    sort:
      - property: title
        direction: ASC
